+            continue;
+        }
+        const u64 hash = XXH3_64bits(reinterpret_cast<const void*>(addr), PageSize);
+        if (entry.epoch != 0 && entry.hash != hash) {
+            memory_tracker->MarkRegionAsCpuModified(addr, PageSize);
+        }
+        entry.hash = hash;
+        entry.epoch = hash_epoch;
+    }
